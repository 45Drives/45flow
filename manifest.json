    {
      "group": "rocky",
      "os_name": "rocky-el9",
      "image": "ci.cr.45d.io/ci/houston-broadcaster/rocky-el9-houston-broadcaster:1"
    },
    {
      "group": "debian",
      "os_name": "debian-bookworm",
      "image": "ci.cr.45d.io/ci/houston-broadcaster/debian-bookworm-houston-broadcaster:1"
    },
    {
      "group": "debian",
      "os_name": "debian-trixie",
